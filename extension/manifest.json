{
  "manifest_version": 3,
  "name": "Tally for Canvas",
  "version": "1.0.0",
  "description": "Brings your Canvas classes, assignment sections and grades into Tally, and keeps them up to date. Everything stays in your browser.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Tally for Canvas",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://parthivrb.github.io/grade-tracker/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://parthivrb.github.io/grade-tracker/*"],
      "js": ["tally-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
